# Copy to .env.local. `make compose-up` loads it automatically. Never commit real credentials.

APP_NAME=Meetings AI
APP_ENV=development
AUTO_MOM_ENABLED=1
AUTO_KNOWLEDGE_INDEX_ENABLED=1
AUTO_RETENTION_ENABLED=1
# Required together for the local owner login. The password seeds the owner
# account only once; subsequent password changes are stored in PostgreSQL.
MEETINGS_AI_ADMIN_EMAIL=developer@genaiprotos.com
MEETINGS_AI_ADMIN_PASSWORD=
MEETINGS_AI_SESSION_SECRET=
APP_BASE_URL=http://localhost:3020
API_BASE_URL=http://localhost:8320
DATABASE_URL=postgresql+psycopg://meetings_ai:meetings_ai_local_only@localhost:5434/meetings_ai
MINIO_ENDPOINT=http://localhost:9010
MINIO_ACCESS_KEY=meetings-ai-local
MINIO_SECRET_KEY=replace-with-generated-local-secret

# Product encryption key used to protect credentials saved through the UI.
# Generate locally before enabling persistent provider profiles.
PROVIDER_CREDENTIAL_KEY=

# Optional initial managed-provider profile.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=

# Optional per-user calendar connections via Composio. Keep the API key server-side.
COMPOSIO_API_KEY=
COMPOSIO_GOOGLE_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_OUTLOOK_AUTH_CONFIG_ID=
COMPOSIO_CALENDLY_AUTH_CONFIG_ID=
COMPOSIO_ZOOM_AUTH_CONFIG_ID=
COMPOSIO_GOOGLE_CALENDAR_VERSION=20260915_00
COMPOSIO_OUTLOOK_VERSION=20260922_00
COMPOSIO_CALENDLY_VERSION=20260915_00
COMPOSIO_ZOOM_VERSION=20260903_00
AUTO_CALENDAR_SCHEDULE_ENABLED=1

# Optional Resend provider. Rotate any key previously shared in chat.
RESEND_API_KEY=
RESEND_FROM_NAME=Meetings AI
# Use onboarding@resend.dev only for Resend's restricted initial test; use a
# verified product-domain sender for normal delivery.
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Vexa Lite / capture adapter
VEXA_BASE_URL=http://localhost:8056
VEXA_AGENT_API_URL=http://localhost:8100
VEXA_API_KEY=
VEXA_PINNED_VERSION=v0.12.27
VEXA_PINNED_COMMIT=1a8084e9a7f57a79902ed9bad9ae3b5c11c01e10
VEXA_STT_MODE=local
# Shared only by the product API and the custom Vexa Lite fork. Generate 32 random bytes.
VEXA_STT_OVERRIDE_SECRET=

# Optional Vexa-native or self-hosted transcription route.
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_SERVICE_TOKEN=
TRANSCRIPTION_MODEL=

# Product defaults identify provider-profile IDs, not raw provider names.
DEFAULT_TRANSCRIPTION_PROFILE_ID=
DEFAULT_TEXT_PROFILE_ID=
DEFAULT_EMBEDDING_PROFILE_ID=
